        "# par comparaison de versions successives. Les modifier change silencieusement\n",
        "# le nombre de TVA trouvées. Voir le README, section « Règles intangibles ».\n",
        "# ═══════════════════════════════════════════════════════════════\n",
        "import io, re, time, math, unicodedata\n",
