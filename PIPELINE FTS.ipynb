        "            return _pa + \"|\" + _adn + \"|\" + _cpn + \"|\" + _vin\n",
        "        # clés d'identité de chaque ligne (position -> liste de clés)\n",
        "        _keys_list = []\n",
        "        for _ix, _nv in zip(df.index, df[col_src_nom]):\n",
        "            _ks = []\n",
        "            _b = _base_benef(_nv)\n",
